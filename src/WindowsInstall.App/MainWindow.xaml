<Window x:Class="ComputerExtra.WindowsInstall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComputerExtra Windows Install"
        Height="360"
        Width="640"
        MinHeight="320"
        MinWidth="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="ComputerExtra Windows Install" />
            <TextBlock Margin="0,16,0,0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Sicherer Entwicklungsmodus" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Text="Diese frühe GUI enthält keine produktiven Windows-Änderungen. Lokale Entwicklung, Build, Tests und GUI-Prüfung sind sicher möglich." />
        </StackPanel>
    </Grid>
</Window>